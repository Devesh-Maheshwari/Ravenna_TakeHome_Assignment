# Copy to .env and fill in. `.env` is gitignored.

# --- LLM provider -----------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
# Any chat model your key can reach. Kept in env so the graph never hardcodes one.
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
# Used only when remote embedding is explicitly enabled; local retrieval is default.
EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---------------------------------------------------------------
# Host port 5434 — see docker-compose.yml.
DATABASE_URL=postgresql://support:support@localhost:5434/support_agent

# --- Session lifecycle ------------------------------------------------------
# Idle timeout: no message for this long and the session expires.
SESSION_IDLE_TTL_MINUTES=30
# Absolute cap: a session never outlives this, however active it is.
SESSION_ABSOLUTE_TTL_HOURS=24
# How often the background sweeper looks for expired sessions.
SESSION_SWEEP_INTERVAL_SECONDS=300

# --- Agent limits -----------------------------------------------------------
# Max llm<->tools round trips in a single turn before forcing a wrap-up.
AGENT_MAX_ITERATIONS=6
# Consecutive tool failures before escalating to a human.
ESCALATION_TOOL_FAILURE_THRESHOLD=2
# Retrieval scores below this count as "the knowledge base did not help".
ESCALATION_MIN_RETRIEVAL_SCORE=0.35

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
# JSON in production, pretty console locally.
LOG_JSON=false
# Optional LangSmith tracing. Off unless LANGCHAIN_TRACING_V2=true.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=support-agent
